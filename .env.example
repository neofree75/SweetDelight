# Environment variables - nastavte tieto premenné pre deployment
# Skopírujte tento súbor ako .env a nastavte správne hodnoty

# Stripe konfigurácia (potrebné pre platby)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# ERPNext instance URL (bez koncového lomítka)
ERPNEXT_URL=https://your-erpnext-instance.com

# ERPNext API kľúče - získajte ich v ERPNext cez User > API Keys
ERPNEXT_API_KEY=your_api_key_here
ERPNEXT_API_SECRET=your_api_secret_here

# Názov firmy v ERPNext (povinné pre Sales Orders)
ERPNEXT_COMPANY=Your Company Name

# Session secret pre Express sessions (vygenerujte si silný kľúč)
SESSION_SECRET=your-super-secure-session-secret-at-least-32-characters-long

# Port pre server (default: 5000)
PORT=5001

# Prostredie (development/production)
NODE_ENV=production