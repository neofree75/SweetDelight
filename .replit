modules = ["nodejs-20", "web", "bash"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 35347
externalPort = 3001

[[ports]]
localPort = 35717
externalPort = 8099

[[ports]]
localPort = 36777
externalPort = 3002

[[ports]]
localPort = 36879
externalPort = 3003

[[ports]]
localPort = 37003
externalPort = 6800

[[ports]]
localPort = 37227
externalPort = 4200

[[ports]]
localPort = 37657
externalPort = 5173

[[ports]]
localPort = 38525
externalPort = 5000

[[ports]]
localPort = 39845
externalPort = 3000

[[ports]]
localPort = 41347
externalPort = 8081

[[ports]]
localPort = 41359
externalPort = 8000

[[ports]]
localPort = 42001
externalPort = 8080

[[ports]]
localPort = 42075
externalPort = 9000

[[ports]]
localPort = 42881
externalPort = 8008

[[ports]]
localPort = 46739
externalPort = 6000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
integrations = ["javascript_openai:1.0.0", "javascript_stripe:1.0.0"]
expertMode = true
